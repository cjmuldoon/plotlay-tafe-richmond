table Buildings
	lineageTag: 9fdd5aad-7ea5-28df-6738-692b788cee0a

	measure 'Buildings count' = DISTINCTCOUNT ( Buildings[key] )
		formatString: 0
		displayFolder: Buildings
		lineageTag: 3ef496a4-7017-ec71-52be-c34c27d8ae7a

	/// As drawn in Plotlay over NSW Imagery
	measure 'Footprint m2' = SUM ( Buildings[footprint_m2] )
		formatString: #,0
		displayFolder: Buildings
		lineageTag: c0b40305-1637-e7c0-8ae0-db21a49011c9

	/// How accurate each outline is likely to be, from how it was drawn
	measure 'Mean accuracy m' = AVERAGE ( Buildings[outline_accuracy_m] )
		formatString: 0.0
		displayFolder: Buildings
		lineageTag: eb9fe928-ad55-adfc-a4a0-4dec71478625

	/// How far Microsoft footprints were off the roof edges
	measure 'Microsoft offset median m' = MEDIAN ( Buildings[microsoft_offset_m] )
		formatString: 0.00
		displayFolder: Buildings
		lineageTag: 58ded99c-6a50-4cb0-2452-344733cf3c63

	measure 'Not in Microsoft footprints' = CALCULATE ( DISTINCTCOUNT ( Buildings[key] ), Buildings[in_microsoft_footprints] = "no" )
		formatString: 0
		displayFolder: Buildings
		lineageTag: 307918f6-9068-b796-53bc-4ed7fec1ecb2

	/// The campus as drawn along its fences and roads
	measure 'Site m2' = SUM ( Site[area_m2] )
		formatString: #,0
		displayFolder: Site level
		lineageTag: 8f6cb6f5-bc77-fa9b-ee57-01ba9a846a60

	/// For the map: each outline source as a code (1 to 3), coloured on a gradient
	measure 'Outline source code' = SWITCH ( SELECTEDVALUE ( Buildings[outline_source] ), "Traced over NSW Imagery, started from the Microsoft footprint and fitted to the roof edges", 1, "Traced over NSW Imagery (not in the Microsoft footprints)", 2, "Microsoft footprint, picked as it is (a complex roof, not refined)", 3 )
		formatString: 0
		lineageTag: f669d729-de09-659b-ca66-fd4a47afc3f4

	column key
		dataType: string
		lineageTag: 1e555345-fe10-8565-7067-a048dc11695d
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = Automatic

	column outline_source
		dataType: string
		lineageTag: 7a2ccbc2-4974-509b-524b-61f57bfb29d0
		summarizeBy: none
		sourceColumn: outline_source

		annotation SummarizationSetBy = Automatic

	column outline_accuracy_m
		dataType: double
		formatString: 0.0
		lineageTag: 4253e024-7276-f380-5f07-4b52b5ef59d2
		summarizeBy: none
		sourceColumn: outline_accuracy_m

		annotation SummarizationSetBy = Automatic

	column footprint_m2
		dataType: double
		formatString: #,0
		lineageTag: e51946b1-7cd4-a500-bec8-a9b3c46296b4
		summarizeBy: none
		sourceColumn: footprint_m2

		annotation SummarizationSetBy = Automatic

	column perimeter_m
		dataType: double
		formatString: #,0
		lineageTag: b5658095-ba0c-96de-b858-555cf4811e0c
		summarizeBy: none
		sourceColumn: perimeter_m

		annotation SummarizationSetBy = Automatic

	column microsoft_offset_m
		dataType: double
		formatString: 0.00
		lineageTag: 2f1529ce-9861-a6fd-54ee-817d5275a781
		summarizeBy: none
		sourceColumn: microsoft_offset_m

		annotation SummarizationSetBy = Automatic

	column microsoft_overlap
		dataType: double
		formatString: 0.00
		lineageTag: 567837e4-61dc-ae8c-c06a-da2bed91a8d2
		summarizeBy: none
		sourceColumn: microsoft_overlap

		annotation SummarizationSetBy = Automatic

	column in_microsoft_footprints
		dataType: string
		lineageTag: 2e10ea47-ae39-777c-6c62-5f06688879c9
		summarizeBy: none
		sourceColumn: in_microsoft_footprints

		annotation SummarizationSetBy = Automatic

	column shape
		dataType: string
		lineageTag: 3bfebc3e-3237-efd7-60cd-3d64c1f517b0
		summarizeBy: none
		sourceColumn: shape

		annotation SummarizationSetBy = Automatic

	partition Buildings = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("buildings/buildings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "outline_source", "outline_accuracy_m", "footprint_m2", "perimeter_m", "microsoft_offset_m", "microsoft_overlap", "in_microsoft_footprints", "shape"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"outline_source", type text}, {"outline_accuracy_m", type number}, {"footprint_m2", type number}, {"perimeter_m", type number}, {"microsoft_offset_m", type number}, {"microsoft_overlap", type number}, {"in_microsoft_footprints", type text}, {"shape", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
