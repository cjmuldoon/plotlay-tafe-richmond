	partition SampleSummary = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("sample/building_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "fabric_condition", "fabric_condition_1to5", "assets", "risk_high_or_extreme", "wo_open", "wo_overdue", "pm_compliance_pct", "esm_overdue", "asbestos_items", "backlog_aud", "after_hours_share_pct", "data_status"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"fabric_condition", type text}, {"fabric_condition_1to5", Int64.Type}, {"assets", Int64.Type}, {"risk_high_or_extreme", Int64.Type}, {"wo_open", Int64.Type}, {"wo_overdue", Int64.Type}, {"pm_compliance_pct", type number}, {"esm_overdue", Int64.Type}, {"asbestos_items", Int64.Type}, {"backlog_aud", type number}, {"after_hours_share_pct", type number}, {"data_status", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
