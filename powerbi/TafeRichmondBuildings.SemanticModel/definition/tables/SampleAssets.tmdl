	partition SampleAssets = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("sample/assets.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"asset_id", "building", "level", "system", "asset_type", "install_year", "expected_life_years", "remaining_life_years", "condition", "condition_1to5", "replacement_cost_aud", "next_due", "service_status", "lat", "lng", "data_status"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"asset_id", type text}, {"building", type text}, {"level", type text}, {"system", type text}, {"asset_type", type text}, {"install_year", Int64.Type}, {"expected_life_years", Int64.Type}, {"remaining_life_years", Int64.Type}, {"condition", type text}, {"condition_1to5", Int64.Type}, {"replacement_cost_aud", type number}, {"next_due", type date}, {"service_status", type text}, {"lat", type number}, {"lng", type number}, {"data_status", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table

