table Site
	lineageTag: a7d6475e-c899-3b72-24d6-facc8cb0ead6

	column key
		dataType: string
		lineageTag: 03ede82b-4a59-3a01-dbc3-fe13d1513195
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = Automatic

	column area_m2
		dataType: double
		formatString: #,0
		lineageTag: dd3cc6e4-445a-91a8-169f-0eb02e4807f4
		summarizeBy: none
		sourceColumn: area_m2

		annotation SummarizationSetBy = Automatic

	column buildings
		dataType: int64
		formatString: 0
		lineageTag: f51a1102-cc3e-f3e0-8244-267481d624e7
