	partition Site = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("site/site_rollup.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "area_m2", "buildings", "footprint_m2"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"area_m2", type number}, {"buildings", Int64.Type}, {"footprint_m2", type number}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table

