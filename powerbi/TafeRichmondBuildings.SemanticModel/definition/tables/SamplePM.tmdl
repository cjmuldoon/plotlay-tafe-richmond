table SamplePM
	lineageTag: 8e32f343-449b-ab46-f5fa-2b96630ec31f

	/// Sample data: not about TAFE NSW Richmond or any real building
	measure 'Sample PM on time' = DIVIDE ( SUM ( SamplePM[on_time] ), SUM ( SamplePM[scheduled] ) )
		formatString: 0.0%
		displayFolder: Sample data
		lineageTag: 626d467f-9929-7ee7-d42f-16e18bb3b18c

	column building
		dataType: string
		isHidden
		lineageTag: efa80cf9-4b8c-7ef2-c918-8ffa21c4a40d
		summarizeBy: none
		sourceColumn: building

		annotation SummarizationSetBy = Automatic

	column month
		dataType: string
		lineageTag: c51791c1-40fa-3d15-a960-d810e48a174d
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column scheduled
		dataType: int64
		formatString: 0
		lineageTag: 15025d7e-6206-3ac8-c146-277c13f0365a
		summarizeBy: none
		sourceColumn: scheduled

		annotation SummarizationSetBy = Automatic

	column on_time
		dataType: int64
		formatString: 0
		lineageTag: dc4f8dac-06a0-3156-b86c-45bf01afebad
		summarizeBy: none
		sourceColumn: on_time

		annotation SummarizationSetBy = Automatic

	column late
		dataType: int64
		formatString: 0
		lineageTag: 92db85d8-5bbe-dd3f-5e16-ba1cfcd667a1
		summarizeBy: none
		sourceColumn: late

		annotation SummarizationSetBy = Automatic

	column missed
		dataType: int64
		formatString: 0
		lineageTag: e8b468c9-737c-9b13-3e81-164b7aae8977
		summarizeBy: none
		sourceColumn: missed

		annotation SummarizationSetBy = Automatic

	column data_status
		dataType: string
		lineageTag: b426f77a-2488-519c-63e6-80ac3f0bf9e7
		summarizeBy: none
		sourceColumn: data_status

		annotation SummarizationSetBy = Automatic

	partition SamplePM = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("sample/pm_compliance.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"building", "month", "scheduled", "on_time", "late", "missed", "data_status"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"building", type text}, {"month", type text}, {"scheduled", Int64.Type}, {"on_time", Int64.Type}, {"late", Int64.Type}, {"missed", Int64.Type}, {"data_status", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
