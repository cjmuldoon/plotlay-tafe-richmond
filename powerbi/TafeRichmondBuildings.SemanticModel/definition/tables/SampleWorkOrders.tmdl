table SampleWorkOrders
	lineageTag: a9893222-324a-791c-6916-e3ae2ee5b91a

	/// Sample data: not about TAFE NSW Richmond or any real building
	measure 'Sample work orders' = COUNTROWS ( SampleWorkOrders )
		formatString: #,0
		displayFolder: Sample data
		lineageTag: e6acc9bf-f5fa-318b-f025-01e73f8a983b

	/// Sample data: not about TAFE NSW Richmond or any real building
	measure 'Sample open work orders' = CALCULATE ( COUNTROWS ( SampleWorkOrders ), NOT SampleWorkOrders[status] IN { "Completed", "Cancelled, missed" } )
		formatString: #,0
		displayFolder: Sample data
		lineageTag: f9ccc3f8-8f42-06e9-94b2-79434871d16a

	/// Sample data: not about TAFE NSW Richmond or any real building
	measure 'Sample overdue work orders' = CALCULATE ( COUNTROWS ( SampleWorkOrders ), SampleWorkOrders[overdue] = "Yes" )
		formatString: #,0
		displayFolder: Sample data
		lineageTag: fe4d2e45-69d0-333a-f87d-04eb06a903f8

