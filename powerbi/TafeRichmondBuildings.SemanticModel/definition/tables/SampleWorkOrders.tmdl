	partition SampleWorkOrders = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("sample/work_orders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"wo_id", "raised", "building", "asset_id", "wo_type", "trade", "priority", "status", "target", "age_days", "overdue", "cost_aud", "data_status"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"wo_id", type text}, {"raised", type date}, {"building", type text}, {"asset_id", type text}, {"wo_type", type text}, {"trade", type text}, {"priority", type text}, {"status", type text}, {"target", type date}, {"age_days", Int64.Type}, {"overdue", type text}, {"cost_aud", type number}, {"data_status", type text}}, "en-AU"),
				    Extra = Table.AddColumn(Typed, "raised_month", each Date.ToText([raised], "yyyy-MM"), type text)
				in
				    Extra

	annotation PBI_ResultType = Table

